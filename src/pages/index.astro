---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Education from '../components/sections/Education.astro';
import Experience from '../components/sections/Experience.astro';
import Projects from '../components/sections/Projects.astro';
import HireMe from '../components/sections/HireMe.astro';
import { site } from '@/data/site';
import { navItems } from '@/data/navigation';
import '../styles/global.css';
---

<Layout title={site.meta.title} description={site.meta.description}>
  <div class="h-screen flex flex-col overflow-hidden">

    <!-- Main content (header absorbed into the left panel) -->
    <main class="flex-1 overflow-hidden">
      <div class="h-full max-w-5xl mx-auto flex">

        <!-- Left panel: profile + nav + socials (desktop only) -->
        <aside class="hidden md:flex w-52 flex-shrink-0 border-r border-white/[0.05]">
          <Nav />
        </aside>

        <!-- Section content -->
        <div class="flex-1 relative overflow-hidden">
          <section data-section="hero" class="absolute inset-0 overflow-y-auto anim-in" aria-label="Home">
            <Hero />
          </section>

          <section data-section="education" class="absolute inset-0 overflow-y-auto hidden" aria-label="Education" aria-hidden="true">
            <Education />
          </section>

          <section data-section="experience" class="absolute inset-0 overflow-y-auto hidden" aria-label="Experience" aria-hidden="true">
            <Experience />
          </section>

          <section data-section="projects" class="absolute inset-0 overflow-y-auto hidden" aria-label="Projects" aria-hidden="true">
            <Projects />
          </section>

          <section data-section="hire" class="absolute inset-0 overflow-y-auto hidden" aria-label="Hire Me" aria-hidden="true">
            <HireMe />
          </section>
        </div>

      </div>
    </main>

    <!-- Mobile bottom navigation bar -->
    <nav
      class="md:hidden flex-shrink-0 border-t border-white/[0.05] bg-[#09090b]/90 backdrop-blur-xl"
      role="navigation"
      aria-label="Mobile navigation"
    >
      <div class="flex items-center h-14 px-1">
        {navItems.map(({ id, label, icon }, i) => (
          <button
            data-nav-item={id}
            aria-current={i === 0 ? "page" : "false"}
            class="flex-1 flex flex-col items-center justify-center gap-1 py-2 text-gray-600 aria-[current=page]:text-white hover:text-gray-400 transition-colors duration-150 cursor-pointer"
          >
            <span set:html={icon} />
            <span class="text-[9px] font-medium tracking-wide">
              {id === 'hire' ? 'Hire' : label}
            </span>
          </button>
        ))}
      </div>
    </nav>

  </div>
</Layout>

<script>
  function switchTo(id: string) {
    const active = document.querySelector<HTMLElement>('[data-section]:not(.hidden)');
    const target = document.querySelector<HTMLElement>(`[data-section="${id}"]`);
    if (!target || target === active) return;

    active?.classList.add('anim-out');

    setTimeout(() => {
      active?.classList.remove('anim-out');
      active?.classList.add('hidden');
      active?.setAttribute('aria-hidden', 'true');

      target.classList.remove('hidden');
      target.setAttribute('aria-hidden', 'false');
      target.classList.add('anim-in');
      target.addEventListener('animationend', () => target.classList.remove('anim-in'), { once: true });
      target.scrollTop = 0;
    }, 200);

    document.querySelectorAll<HTMLElement>('[data-nav-item]').forEach((el) => {
      el.setAttribute('aria-current', el.dataset.navItem === id ? 'page' : 'false');
    });
  }

  document.querySelectorAll<HTMLElement>('[data-nav-item]').forEach((el) => {
    el.addEventListener('click', () => switchTo(el.dataset.navItem!));
  });
</script>
