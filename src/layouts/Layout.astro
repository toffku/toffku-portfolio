---
import { site } from "@/data/site";
import Cursor from "@/components/Cursor.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.meta.title,
  description = site.meta.description,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="font-sans text-gray-100 antialiased">

    <!-- Page-load entrance: "KU" monogram fades in then the overlay lifts -->
    <div id="page-loader" aria-hidden="true">
      <span id="loader-mark">KU</span>
    </div>

    <Cursor />
    <slot />

  </body>
</html>

<script>
  window.addEventListener('load', () => {
    const loader = document.getElementById('page-loader');
    if (!loader) return;
    const elapsed = performance.now();
    const remaining = Math.max(0, 700 - elapsed);
    setTimeout(() => {
      loader.classList.add('is-done');
      loader.addEventListener('animationend', () => loader.remove(), { once: true });
    }, remaining);
  });
</script>
