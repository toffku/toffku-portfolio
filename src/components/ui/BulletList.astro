---
import { emphasise } from "@/utils/format";

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="space-y-2">
  {items.map((item) => (
    <li class="flex items-start gap-2.5 text-sm text-gray-400 leading-relaxed">
      <span aria-hidden="true" class="mt-[9px] w-[3px] h-[3px] rounded-full bg-white/[0.2] flex-shrink-0"></span>
      <span set:html={emphasise(item)} />
    </li>
  ))}
</ul>
