---
import { navItems } from "@/data/navigation";
import { socials } from "@/data/socials";
---

<!-- ── Mobile header bar ─────────────────────────────────────────── -->
<header
  class="md:hidden flex items-center justify-between h-14 px-5 border-b border-white/[0.05] flex-shrink-0"
>
  <span class="font-bold text-lg tracking-tight text-white">KU</span>

  <button
    id="nav-open"
    aria-label="Open navigation"
    aria-expanded="false"
    aria-controls="nav-drawer"
    class="w-9 h-9 flex items-center justify-center text-gray-400 hover:text-white transition-colors duration-200 cursor-pointer"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>
</header>

<!-- ── Overlay (fixed, covers entire screen) ────────────────────── -->
<div
  id="nav-overlay"
  aria-hidden="true"
  class="md:hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300"
></div>

<!-- ── Drawer ────────────────────────────────────────────────────── -->
<aside
  id="nav-drawer"
  inert
  aria-label="Navigation"
  class="md:hidden fixed inset-y-0 left-0 w-72 bg-[#111] border-r border-white/[0.06] z-50 flex flex-col -translate-x-full transition-transform duration-300 ease-out"
>

  <!-- Drawer header -->
  <div class="flex items-center justify-between h-14 px-5 border-b border-white/[0.05] flex-shrink-0">
    <span class="font-bold text-lg tracking-tight text-white">KU</span>
    <button
      id="nav-close"
      aria-label="Close navigation"
      class="w-9 h-9 flex items-center justify-center text-gray-400 hover:text-white transition-colors duration-200 cursor-pointer"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Nav items -->
  <nav class="flex-1 flex flex-col justify-center px-3 gap-1 py-6" aria-label="Section navigation">
    {navItems.map(({ id, label, icon }, i) => (
      <button
        data-nav-item={id}
        aria-current={i === 0 ? "page" : "false"}
        class="group relative flex items-center gap-3.5 w-full py-3 pl-4 pr-4 rounded-lg text-left cursor-pointer aria-[current=page]:bg-indigo-500/[0.07] transition-colors duration-200"
      >
        <!-- Left accent bar (scales in when active) -->
        <span
          aria-hidden="true"
          class="absolute left-0 inset-y-3 w-[2px] rounded-full bg-indigo-400 scale-y-0 opacity-0 group-aria-[current=page]:scale-y-100 group-aria-[current=page]:opacity-100 transition-all duration-300 origin-center"
        ></span>
        <span
          class="text-gray-500 group-hover:text-gray-300 group-aria-[current=page]:text-indigo-400 transition-colors duration-200 flex-shrink-0"
          set:html={icon}
        />
        <span class="text-sm font-semibold text-gray-400 group-hover:text-gray-100 group-aria-[current=page]:text-white transition-colors duration-200">
          {label}
        </span>
      </button>
    ))}
  </nav>

  <!-- Divider + socials -->
  <div class="h-px bg-white/[0.05] mx-5 flex-shrink-0"></div>
  <div class="px-5 py-5 flex-shrink-0 flex items-center gap-2">
    {socials.map((social) => (
      <a
        href={social.href}
        target={social.href.startsWith("mailto") ? undefined : "_blank"}
        rel={social.href.startsWith("mailto") ? undefined : "noopener noreferrer"}
        aria-label={social.label}
        class="w-9 h-9 flex items-center justify-center text-gray-500 hover:text-white transition-all duration-300 hover:scale-110 active:scale-95"
      >
        <span set:html={social.icon} />
      </a>
    ))}
  </div>

</aside>

<script>
  const openBtn  = document.getElementById('nav-open')  as HTMLButtonElement | null;
  const closeBtn = document.getElementById('nav-close') as HTMLButtonElement | null;
  const overlay  = document.getElementById('nav-overlay') as HTMLElement | null;
  const drawer   = document.getElementById('nav-drawer')  as HTMLElement | null;

  function openDrawer(): void {
    drawer?.removeAttribute('inert');
    drawer?.classList.remove('-translate-x-full');
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    overlay?.classList.add('opacity-100');
    openBtn?.setAttribute('aria-expanded', 'true');
    closeBtn?.focus();
  }

  function closeDrawer(): void {
    openBtn?.focus();
    drawer?.setAttribute('inert', '');
    drawer?.classList.add('-translate-x-full');
    overlay?.classList.remove('opacity-100');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    openBtn?.setAttribute('aria-expanded', 'false');
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  // Close drawer when a nav item inside it is clicked
  drawer?.querySelectorAll<HTMLElement>('[data-nav-item]').forEach(btn => {
    btn.addEventListener('click', closeDrawer);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });
</script>
