---
import Image from "astro/components/Image.astro";
import { site } from "@/data/site";
import { navItems } from "@/data/navigation";
import { socials } from "@/data/socials";
---

<div class="h-full flex flex-col">

  <!-- Profile -->
  <div class="px-5 pt-8 pb-6 flex-shrink-0">
    <div class="w-10 h-10 rounded-xl overflow-hidden ring-1 ring-white/[0.08] mb-4">
      <Image
        src={site.avatar}
        alt={`${site.name} avatar`}
        width={40}
        height={40}
        class="object-cover w-full h-full"
        loading="eager"
      />
    </div>
    <p class="text-sm font-semibold text-white leading-none mb-1">{site.name}</p>
    <p class="text-xs text-gray-500 mb-3">{site.title}</p>
    {site.availability.available && (
      <div class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 pulse-dot flex-shrink-0"></span>
        <span class="text-[11px] text-emerald-400/80 font-medium">{site.availability.label}</span>
      </div>
    )}
  </div>

  <!-- Divider -->
  <div class="h-px bg-white/[0.05] mx-5 flex-shrink-0"></div>

  <!-- Navigation — vertically centered in remaining space -->
  <nav
    role="navigation"
    aria-label="Section navigation"
    class="flex-1 px-3 flex flex-col justify-center gap-0.5"
  >
    {navItems.map(({ id, label, icon }, i) => (
      <button
        data-nav-item={id}
        aria-current={i === 0 ? "page" : "false"}
        class="group relative flex items-center gap-3 w-full py-2.5 pl-4 pr-3 rounded-lg text-left cursor-pointer hover:bg-white/[0.04] aria-[current=page]:bg-white/[0.05] transition-colors duration-150"
      >
        <!-- Active indicator bar -->
        <span class="absolute left-0 top-1/2 -translate-y-1/2 w-0.5 h-5 rounded-full bg-indigo-400 opacity-0 group-aria-[current=page]:opacity-100 transition-opacity duration-200 ease-out"></span>

        <!-- Icon -->
        <span
          class="text-gray-600 group-hover:text-gray-400 group-aria-[current=page]:text-indigo-400 transition-colors duration-150 flex-shrink-0"
          set:html={icon}
        />

        <!-- Label -->
        <span class="text-sm font-medium text-gray-500 group-hover:text-gray-200 group-aria-[current=page]:text-white transition-colors duration-150">
          {label}
        </span>
      </button>
    ))}
  </nav>

  <!-- Divider -->
  <div class="h-px bg-white/[0.05] mx-5 flex-shrink-0"></div>

  <!-- Social links -->
  <div class="px-5 py-5 flex-shrink-0">
    <div class="flex items-center gap-1.5">
      {socials.map((social) => (
        <a
          href={social.href}
          target={social.href.startsWith("mailto") ? undefined : "_blank"}
          rel={social.href.startsWith("mailto") ? undefined : "noopener noreferrer"}
          aria-label={social.label}
          class="w-7 h-7 rounded-md bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.06] flex items-center justify-center text-gray-600 hover:text-gray-300 transition-all duration-150"
        >
          <span set:html={social.icon} />
        </a>
      ))}
    </div>
  </div>

</div>
