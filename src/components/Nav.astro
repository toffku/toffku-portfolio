---
import Image from "astro/components/Image.astro";
import { site } from "@/data/site";
import { navItems } from "@/data/navigation";
import { socials } from "@/data/socials";
---

<div class="h-full flex flex-col">

  <!-- Profile -->
  <div class="px-5 pt-8 pb-6 flex-shrink-0">
    <div class="w-10 h-10 rounded-xl overflow-hidden ring-1 ring-white/[0.08] mb-4">
      <Image
        src={site.avatar}
        alt={`${site.name} avatar`}
        width={40}
        height={40}
        class="object-cover w-full h-full"
        loading="eager"
      />
    </div>
    <p class="text-sm font-semibold text-white leading-none mb-1">{site.name}</p>
    <p class="text-xs text-gray-500 mb-3">{site.title}</p>
    {site.availability.available && (
      <div class="flex items-center gap-1.5">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" class="status-spin text-amber-400 flex-shrink-0" aria-hidden="true">
          <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
        </svg>
        <span class="text-[11px] text-amber-400/80 font-medium">{site.availability.label}</span>
      </div>
    )}
  </div>

  <!-- Divider -->
  <div class="h-px bg-white/[0.05] mx-5 flex-shrink-0"></div>

  <!-- Navigation -->
  <nav
    role="navigation"
    aria-label="Section navigation"
    data-nav-rail
    class="relative flex-1 px-3 flex flex-col justify-center gap-0.5"
  >
    <!-- Sliding active indicator — positioned by JS -->
    <span
      id="nav-indicator"
      aria-hidden="true"
      class="pointer-events-none absolute left-3 top-0 w-0.5 rounded-full bg-indigo-400 opacity-0"
    ></span>

    {navItems.map(({ id, label, icon }, i) => (
      <button
        data-nav-item={id}
        aria-current={i === 0 ? "page" : "false"}
        class="group relative flex items-center gap-3 w-full py-2.5 pl-4 pr-4 rounded-lg text-left cursor-pointer hover:bg-white/[0.04] aria-[current=page]:bg-white/[0.05] aria-[current=page]:my-4 transition-all duration-200 ease-out origin-left aria-[current=page]:scale-[1.12] aria-[current=false]:scale-[0.90]"
      >
        <!-- Icon -->
        <span
          class="text-gray-600 group-hover:text-gray-400 group-aria-[current=page]:text-indigo-400 transition-colors duration-200 flex-shrink-0"
          set:html={icon}
        />

        <!-- Label -->
        <span class="text-sm font-medium text-gray-500 group-hover:text-gray-200 group-aria-[current=page]:text-white transition-colors duration-200">
          {label}
        </span>

      </button>
    ))}
  </nav>

  <!-- Divider -->
  <div class="h-px bg-white/[0.05] mx-5 flex-shrink-0"></div>

  <!-- Social links -->
  <div class="px-5 py-5 flex-shrink-0">
    <div class="flex items-center gap-2">
      {socials.map((social) => (
        <a
          href={social.href}
          target={social.href.startsWith("mailto") ? undefined : "_blank"}
          rel={social.href.startsWith("mailto") ? undefined : "noopener noreferrer"}
          aria-label={social.label}
          class="w-9 h-9 rounded-lg bg-white/[0.04] hover:bg-white/[0.09] border border-white/[0.07] hover:border-white/[0.15] flex items-center justify-center text-gray-500 hover:text-gray-100 transition-all duration-200 hover:scale-110 active:scale-95"
        >
          <span set:html={social.icon} />
        </a>
      ))}
    </div>
  </div>

</div>

<script>
  const indicator = document.getElementById('nav-indicator') as HTMLElement | null;
  const navRail = document.querySelector<HTMLElement>('[data-nav-rail]');

  if (indicator && navRail) {
    // Track for longer than the button transition (200ms) so the indicator
    // catches up fully via its own short 80ms CSS transition.
    const TRACK_MS = 300;
    let rafId: number | null = null;

    function updatePosition(): void {
      const active = navRail!.querySelector<HTMLElement>('[data-nav-item][aria-current="page"]');
      if (!active) return;
      const navRect = navRail!.getBoundingClientRect();
      const btnRect = active.getBoundingClientRect();
      indicator!.style.height = `${btnRect.height}px`;
      indicator!.style.transform = `translateY(${btnRect.top - navRect.top}px)`;
    }

    function startTracking(): void {
      if (rafId !== null) cancelAnimationFrame(rafId);
      const end = performance.now() + TRACK_MS;
      function tick(): void {
        updatePosition();
        rafId = performance.now() < end ? requestAnimationFrame(tick) : null;
      }
      requestAnimationFrame(tick);
    }

    // Set initial position instantly, then fade the indicator in.
    indicator.style.transition = 'none';
    updatePosition();
    indicator.getBoundingClientRect();
    indicator.style.transition = '';
    requestAnimationFrame(() => requestAnimationFrame(() => { indicator.style.opacity = '1'; }));

    const observer = new MutationObserver(startTracking);
    navRail.querySelectorAll<HTMLElement>('[data-nav-item]').forEach(btn => {
      observer.observe(btn, { attributes: true, attributeFilter: ['aria-current'] });
    });
  }
</script>
