---
import Image from "astro/components/Image.astro";
import { site } from "@/data/site";
import { navItems } from "@/data/navigation";
import { socials } from "@/data/socials";
---

<div class="h-full flex flex-col">

  <!-- Profile header -->
  <div class="px-5 pt-6 pb-5 flex-shrink-0">
    <div class="flex items-center gap-2.5 mb-3">
      <Image
        src={site.avatar}
        alt={site.name}
        width={34}
        height={34}
        class="w-[34px] h-[34px] rounded-full ring-1 ring-white/10 flex-shrink-0 object-cover"
      />
      <div class="min-w-0">
        <p class="text-sm font-semibold text-white truncate leading-snug">{site.name}</p>
        <p class="text-[11px] text-gray-500 truncate leading-snug mt-0.5">{site.title}</p>
      </div>
    </div>
    <div class="flex items-center gap-1.5">
      <!-- Spinning loader icon for "currently building" status -->
      <svg
        class="status-spin text-emerald-400/70 flex-shrink-0"
        width="10" height="10" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2.5"
        stroke-linecap="round" aria-hidden="true"
      >
        <line x1="12" y1="2"  x2="12" y2="6"/>
        <line x1="12" y1="18" x2="12" y2="22"/>
        <line x1="4.93"  y1="4.93"  x2="7.76"  y2="7.76"/>
        <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/>
        <line x1="2"  y1="12" x2="6"  y2="12"/>
        <line x1="18" y1="12" x2="22" y2="12"/>
        <line x1="4.93"  y1="19.07" x2="7.76"  y2="16.24"/>
        <line x1="16.24" y1="7.76"  x2="19.07" y2="4.93"/>
      </svg>
      <span class="text-[11px] text-gray-500">{site.availability.label}</span>
    </div>
  </div>

  <!-- Divider -->
  <div class="h-px bg-white/[0.05] mx-5 flex-shrink-0 mb-1"></div>

  <!-- Navigation -->
  <nav
    role="navigation"
    aria-label="Section navigation"
    data-nav-rail
    class="relative flex-1 px-3 flex flex-col justify-center gap-0.5"
  >
    <!-- Sliding active indicator — positioned by JS -->
    <span
      id="nav-indicator"
      aria-hidden="true"
      class="pointer-events-none absolute left-3 top-0 w-0.5 rounded-full bg-indigo-400 opacity-0"
    ></span>

    {navItems.map(({ id, label, icon }, i) => (
      <button
        data-nav-item={id}
        aria-current={i === 0 ? "page" : "false"}
        class="group relative flex items-center gap-3 w-full py-2.5 pl-4 pr-4 rounded-lg text-left cursor-pointer aria-[current=page]:my-4 transition-all duration-300 ease-out origin-left aria-[current=page]:scale-[1.12] aria-[current=false]:scale-[0.90]"
      >
        <!-- Icon -->
        <span
          class="text-gray-500 group-hover:text-indigo-400/50 group-aria-[current=page]:text-indigo-400 transition-colors duration-300 flex-shrink-0"
          set:html={icon}
        />

        <!-- Label -->
        <span class="text-base font-semibold text-gray-400 group-hover:text-gray-200 group-aria-[current=page]:text-white transition-colors duration-300">
          {label}
        </span>

      </button>
    ))}
  </nav>

  <!-- Divider -->
  <div class="h-px bg-white/[0.05] mx-5 flex-shrink-0"></div>

  <!-- Social links -->
  <div class="px-5 py-5 flex-shrink-0">
    <div class="flex items-center gap-2">
      {socials.map((social) => (
        <a
          href={social.href}
          target={social.href.startsWith("mailto") ? undefined : "_blank"}
          rel={social.href.startsWith("mailto") ? undefined : "noopener noreferrer"}
          aria-label={social.label}
          class="w-9 h-9 flex items-center justify-center text-gray-500 hover:text-white transition-all duration-300 hover:scale-110 active:scale-95"
        >
          <span set:html={social.icon} />
        </a>
      ))}
    </div>
  </div>

</div>

<script>
  const indicator = document.getElementById('nav-indicator') as HTMLElement | null;
  const navRail = document.querySelector<HTMLElement>('[data-nav-rail]');

  if (indicator && navRail) {
    // Track for longer than the button transition (300ms) so the indicator
    // catches up fully via its own short 120ms CSS transition.
    const TRACK_MS = 450;
    let rafId: number | null = null;

    function updatePosition(): void {
      const active = navRail!.querySelector<HTMLElement>('[data-nav-item][aria-current="page"]');
      if (!active) return;
      const navRect = navRail!.getBoundingClientRect();
      const btnRect = active.getBoundingClientRect();
      indicator!.style.height = `${btnRect.height}px`;
      indicator!.style.transform = `translateY(${btnRect.top - navRect.top}px)`;
    }

    function startTracking(): void {
      if (rafId !== null) cancelAnimationFrame(rafId);
      const end = performance.now() + TRACK_MS;
      function tick(): void {
        updatePosition();
        rafId = performance.now() < end ? requestAnimationFrame(tick) : null;
      }
      requestAnimationFrame(tick);
    }

    // Set initial position instantly, then fade the indicator in.
    indicator.style.transition = 'none';
    updatePosition();
    indicator.getBoundingClientRect();
    indicator.style.transition = '';
    requestAnimationFrame(() => requestAnimationFrame(() => { indicator.style.opacity = '1'; }));

    const observer = new MutationObserver(startTracking);
    navRail.querySelectorAll<HTMLElement>('[data-nav-item]').forEach(btn => {
      observer.observe(btn, { attributes: true, attributeFilter: ['aria-current'] });
    });
  }
</script>
