---
import { educationEntries, highlightColors } from "@/data/education";
---

<div class="min-h-full px-8 md:px-10 py-10 md:py-14">
  <div class="max-w-2xl">

    <div class="mb-8">
      <p class="font-mono text-xs text-white/[0.18] mb-2 tracking-wider">02 / Education</p>
      <h2 class="text-2xl font-bold text-white mb-1 tracking-tight">Academic Background</h2>
      <p class="text-gray-600 text-sm">Building a strong engineering foundation.</p>
    </div>

    <div class="relative flex flex-col">
      <div class="absolute left-[7px] top-3 bottom-3 w-px bg-white/[0.06]"></div>

      {educationEntries.map((entry) => (
        <div class="relative flex gap-5 pb-7 last:pb-0">
          <div class="flex-shrink-0 mt-1.5 z-10">
            <div class="w-3.5 h-3.5 rounded-full border-2 border-white/[0.18] bg-[#09090b]"></div>
          </div>

          <div class="flex-1 bg-white/[0.03] hover:bg-white/[0.05] border border-white/[0.07] hover:border-white/[0.12] rounded-xl p-5 transition-all duration-200">
            <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
              <div>
                <h3 class="text-sm font-semibold text-white leading-snug mb-0.5">{entry.degree}</h3>
                <p class="text-xs text-gray-500">{entry.institution}</p>
              </div>
              <div class="flex flex-col items-end gap-1.5 flex-shrink-0">
                {entry.inProgress ? (
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">
                    {entry.status}
                  </span>
                ) : (
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-white/[0.05] text-gray-500 border border-white/[0.08]">
                    {entry.status}
                  </span>
                )}
                <span class="text-xs text-gray-600 font-mono">{entry.period}</span>
              </div>
            </div>

            <p class="text-xs text-gray-500 leading-relaxed mb-3">{entry.description}</p>

            <div class="flex flex-wrap gap-1.5">
              {entry.highlights.map((tag) => (
                <span class={`text-xs font-mono px-2 py-0.5 rounded-md border ${highlightColors[tag] ?? "bg-white/[0.04] text-gray-600 border-white/[0.07]"}`}>
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</div>
