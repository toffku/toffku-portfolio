---
import { educationEntries, highlightColors } from "@/data/education";
---

<div class="min-h-full px-8 md:px-10 py-10 md:py-14">
  <div class="max-w-2xl">

    <div class="mb-10">
      <p class="font-mono text-xs text-white/[0.18] mb-3 tracking-wider">02 / Education</p>
      <h2 class="text-2xl font-bold text-white tracking-tight">Academic Background</h2>
    </div>

    <div>
      {educationEntries.map((entry) => (
        <div class="group border-t border-white/[0.06] py-6 hover:bg-white/[0.04] -mx-3 px-3 rounded transition-colors duration-200">
          <div class="grid sm:grid-cols-[8rem_1fr] gap-x-8 gap-y-3">
            <p class="font-mono text-[10px] text-white/[0.25] leading-relaxed sm:pt-0.5">{entry.period}</p>
            <div>
              <div class="flex items-start justify-between gap-4 mb-1">
                <h3 class="text-sm font-semibold text-white leading-snug">{entry.degree}</h3>
                <span class={`text-xs font-semibold flex-shrink-0 ${entry.inProgress ? "text-emerald-400" : "text-gray-600"}`}>
                  {entry.status}
                </span>
              </div>
              <p class="text-xs text-gray-500 mb-3">{entry.institution}</p>
              <p class="text-xs text-gray-600 font-light leading-relaxed mb-3">{entry.description}</p>
              <div class="flex flex-wrap gap-x-4 gap-y-1">
                {entry.highlights.map((tag) => (
                  <span class={`text-xs font-mono ${highlightColors[tag] ?? "text-gray-600"}`}>{tag}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</div>
