---
import { experienceEntries, recognition } from "@/data/experience";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import BulletList from "@/components/ui/BulletList.astro";
---

<div class="min-h-full px-8 md:px-10 py-10 md:py-14">
  <div class="max-w-2xl">

    <SectionHeader title="Work Experience" />

    <div class="entry-list">
      {experienceEntries.map((entry) => (
        <article class="entry-row group relative border-t border-white/[0.06] py-6 -mx-3 px-3 rounded">
          <span
            aria-hidden="true"
            class="absolute left-0 inset-y-4 w-[2px] rounded-full bg-indigo-400/60 scale-y-0 group-hover:scale-y-100 opacity-0 group-hover:opacity-100 transition-all duration-500 origin-center"
          ></span>
          <div class="grid sm:grid-cols-[8rem_1fr] gap-x-8 gap-y-3">
            <div class="sm:pt-0.5">
              <p class="font-mono text-xs text-white/50 leading-relaxed">{entry.period}</p>
              {entry.current && (
                <p class="mt-1.5 font-mono text-[10px] text-emerald-400/80 tracking-wide uppercase">Current role</p>
              )}
            </div>
            <div>
              <h3 class="text-base font-semibold text-white leading-snug mb-1">{entry.role}</h3>
              <p class="text-sm text-gray-400">{entry.company}</p>

              {entry.bullets && (
                <div class="mt-4">
                  <BulletList items={entry.bullets} />
                </div>
              )}

              {entry.engagements?.map((engagement) => (
                <section class="mt-5">
                  <h4 class="text-sm font-semibold text-gray-200">{engagement.title}</h4>
                  <p class="text-xs text-gray-500 mt-0.5 mb-3">{engagement.context}</p>
                  <BulletList items={engagement.bullets} />
                </section>
              ))}
            </div>
          </div>
        </article>
      ))}

      {recognition.map((item) => (
        <article class="entry-row group relative border-t border-white/[0.06] py-6 -mx-3 px-3 rounded">
          <span
            aria-hidden="true"
            class="absolute left-0 inset-y-4 w-[2px] rounded-full bg-indigo-400/60 scale-y-0 group-hover:scale-y-100 opacity-0 group-hover:opacity-100 transition-all duration-500 origin-center"
          ></span>
          <div class="grid sm:grid-cols-[8rem_1fr] gap-x-8 gap-y-3">
            <p class="font-mono text-xs text-white/50 leading-relaxed sm:pt-0.5">{item.period}</p>
            <div>
              <h3 class="text-base font-semibold text-white leading-snug mb-1">{item.title}</h3>
              <p class="text-sm text-gray-400">{item.organisation}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</div>
