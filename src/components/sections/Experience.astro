---
import { experienceEntries, typeColors } from "@/data/experience";
---

<div class="min-h-full px-8 md:px-10 py-10 md:py-14">
  <div class="max-w-2xl">

    <div class="mb-10">
      <p class="font-mono text-xs text-white/[0.18] mb-3 tracking-wider">03 / Experience</p>
      <h2 class="text-2xl font-bold text-white tracking-tight">Work Experience</h2>
    </div>

    <div>
      {experienceEntries.map((entry) => (
        <div class="group border-t border-white/[0.06] py-6 hover:bg-white/[0.04] -mx-3 px-3 rounded transition-colors duration-200">
          <div class="grid sm:grid-cols-[8rem_1fr] gap-x-8 gap-y-3">
            <p class="font-mono text-[10px] text-white/[0.25] leading-relaxed sm:pt-0.5">{entry.period}</p>
            <div>
              <div class="flex items-start justify-between gap-4 mb-1">
                <h3 class="text-sm font-semibold text-white leading-snug">{entry.role}</h3>
                <span class={`text-xs font-semibold flex-shrink-0 ${typeColors[entry.type] ?? "text-gray-500"}`}>
                  {entry.type}
                </span>
              </div>
              <p class="text-xs text-gray-500 mb-4">{entry.company}</p>
              <ul class="space-y-2">
                {entry.bullets.map((b) => (
                  <li class="flex items-start gap-2.5 text-xs text-gray-600 font-light leading-relaxed">
                    <span class="mt-[5px] w-[3px] h-[3px] rounded-full bg-white/[0.2] flex-shrink-0"></span>
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</div>
