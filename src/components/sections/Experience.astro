---
import { experienceEntries, typeColors } from "@/data/experience";
---

<div class="min-h-full px-8 md:px-10 py-10 md:py-14">
  <div class="max-w-2xl">

    <div class="mb-10">
      <p class="font-mono text-sm text-white/[0.30] mb-3 tracking-wider">03 / Experience</p>
      <h2 class="text-3xl font-bold text-white tracking-tight">Work Experience</h2>
    </div>

    <div class="entry-list">
      {experienceEntries.map((entry) => (
        <div class="entry-row group relative border-t border-white/[0.06] py-6 -mx-3 px-3 rounded">
          <span
            aria-hidden="true"
            class="absolute left-0 inset-y-4 w-[2px] rounded-full bg-indigo-400/60 scale-y-0 group-hover:scale-y-100 opacity-0 group-hover:opacity-100 transition-all duration-500 origin-center"
          ></span>
          <div class="grid sm:grid-cols-[8rem_1fr] gap-x-8 gap-y-3">
            <p class="font-mono text-xs text-white/[0.35] leading-relaxed sm:pt-0.5">{entry.period}</p>
            <div>
              <div class="flex items-start justify-between gap-4 mb-1">
                <h3 class="text-base font-semibold text-white leading-snug">{entry.role}</h3>
                <span class={`text-sm font-semibold flex-shrink-0 ${typeColors[entry.type] ?? "text-gray-400"}`}>
                  {entry.type}
                </span>
              </div>
              <p class="text-sm text-gray-400 mb-4">{entry.company}</p>
              <ul class="space-y-2">
                {entry.bullets.map((b) => (
                  <li class="flex items-start gap-2.5 text-sm text-gray-400 font-normal leading-relaxed">
                    <span class="mt-[6px] w-[3px] h-[3px] rounded-full bg-white/[0.2] flex-shrink-0"></span>
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</div>
