---
import { experienceEntries, typeColors } from "@/data/experience";
---

<div class="min-h-full px-8 md:px-10 py-10 md:py-14">
  <div class="max-w-2xl">

    <div class="mb-8">
      <p class="font-mono text-xs text-white/[0.18] mb-2 tracking-wider">03 / Experience</p>
      <h2 class="text-2xl font-bold text-white mb-1 tracking-tight">Work Experience</h2>
      <p class="text-gray-600 text-sm">Professional roles and recognitions.</p>
    </div>

    <div class="relative flex flex-col">
      <div class="absolute left-[7px] top-3 bottom-3 w-px bg-white/[0.06]"></div>

      {experienceEntries.map((entry) => (
        <div class="relative flex gap-5 pb-6 last:pb-0">
          <div class="flex-shrink-0 mt-1.5 z-10">
            <div class="w-3.5 h-3.5 rounded-full border-2 border-white/[0.18] bg-[#09090b]"></div>
          </div>

          <div class="flex-1 bg-white/[0.03] hover:bg-white/[0.05] border border-white/[0.07] hover:border-white/[0.12] rounded-xl p-5 transition-all duration-200">
            <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
              <div>
                <h3 class="text-sm font-semibold text-white leading-snug mb-0.5">{entry.role}</h3>
                <p class="text-xs text-gray-500">{entry.company}</p>
              </div>
              <div class="flex flex-col items-end gap-1.5 flex-shrink-0">
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${typeColors[entry.type] ?? "bg-white/[0.05] text-gray-500 border-white/[0.08]"}`}>
                  {entry.type}
                </span>
                <span class="text-xs text-gray-600 font-mono whitespace-nowrap">{entry.period}</span>
              </div>
            </div>

            <ul class="space-y-1.5">
              {entry.bullets.map((b) => (
                <li class="flex items-start gap-2 text-xs text-gray-500 leading-relaxed">
                  <span class="mt-1.5 w-1 h-1 rounded-full bg-white/[0.18] flex-shrink-0"></span>
                  {b}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

  </div>
</div>
