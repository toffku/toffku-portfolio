---
import { site } from "@/data/site";
import { socials } from "@/data/socials";

const skills = [
  'TypeScript', 'React Native', 'Node.js', 'Astro',
  'JavaScript', 'Tailwind CSS', 'SQL', 'Expo',
  'Git', 'Python', 'PostgreSQL', 'Docker',
];
---

<div class="min-h-full flex flex-col justify-center px-8 md:px-10 py-14">
  <div class="max-w-lg">

    <h1 class="text-6xl md:text-7xl font-bold leading-[1.02] tracking-tight text-white mb-6">
      {site.name}
    </h1>

    <div class="h-px bg-white/[0.07] mb-6"></div>

    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-6">
      <span class="text-sm text-gray-400 font-light">{site.title}</span>
    </div>

    <p class="text-base text-gray-400 font-light leading-relaxed mb-7 max-w-sm">
      {site.bio}
    </p>

    <!-- Skills ticker — infinite horizontal scroll with fade-edge masking -->
    <div
      class="relative mb-8 overflow-hidden"
      style="-webkit-mask: linear-gradient(90deg, transparent, black 14%, black 86%, transparent); mask: linear-gradient(90deg, transparent, black 14%, black 86%, transparent);"
      aria-label="Technical skills"
    >
      <ul class="ticker-track flex items-center gap-7 w-max select-none" aria-hidden="true">
        {[...skills, ...skills].map((skill) => (
          <li class="flex-shrink-0 flex items-center gap-2.5 text-[11px] font-mono text-gray-600 tracking-widest uppercase whitespace-nowrap">
            <span class="w-[3px] h-[3px] rounded-full bg-white/20 flex-shrink-0"></span>
            {skill}
          </li>
        ))}
      </ul>
    </div>

    <div class="flex items-center gap-6">
      <button
        data-nav-item="hire"
        class="group inline-flex items-center gap-2 text-emerald-400 hover:text-emerald-300 text-base font-semibold cursor-pointer transition-colors duration-300"
      >
        Hire Me
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 transition-transform duration-300">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </button>

      <div class="flex items-center gap-4 md:hidden">
        {socials.map((social) => (
          <a
            href={social.href}
            target={social.href.startsWith("mailto") ? undefined : "_blank"}
            rel={social.href.startsWith("mailto") ? undefined : "noopener noreferrer"}
            aria-label={social.label}
            class="text-gray-500 hover:text-white transition-colors duration-200"
          >
            <span set:html={social.icon} />
          </a>
        ))}
      </div>
    </div>

  </div>
</div>
