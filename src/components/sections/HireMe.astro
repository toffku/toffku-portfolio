---
import { contacts } from "@/data/contact";
---

<div class="min-h-full flex flex-col justify-center px-8 md:px-10 py-14">
  <div class="max-w-sm">

    <p class="font-mono text-xs text-white/[0.18] mb-8 tracking-wider">05 / Work With Me</p>

    <h2 class="text-3xl md:text-4xl font-bold text-white mb-3 leading-tight tracking-tight">
      Let's Build<br />Something Together
    </h2>

    <p class="text-gray-600 text-sm font-light leading-relaxed mb-10 max-w-xs">
      Feel free to reach out for collaborations, mentorship, or just a chat about tech and startups!
    </p>

    <div>
      {contacts.map((c) => (
        <a
          href={c.href}
          target={c.href.startsWith("mailto") ? undefined : "_blank"}
          rel={c.href.startsWith("mailto") ? undefined : "noopener noreferrer"}
          class="group flex items-center justify-between border-t border-white/[0.06] py-4 hover:bg-white/[0.04] -mx-3 px-3 rounded transition-colors duration-200"
        >
          <div class="flex items-center gap-4">
            <span class="text-gray-700 group-hover:text-white transition-colors flex-shrink-0">
              <span set:html={c.icon} />
            </span>
            <div>
              <p class="text-[10px] text-gray-600 font-semibold uppercase tracking-wider mb-0.5">{c.label}</p>
              <p class="text-sm text-white font-semibold">{c.value}</p>
            </div>
          </div>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-700 group-hover:text-gray-400 transition-colors flex-shrink-0">
            <path d="M7 17L17 7M7 7h10v10"/>
          </svg>
        </a>
      ))}
    </div>

  </div>
</div>
