---
import { contacts } from "@/data/contact";
import { site } from "@/data/site";
---

<div class="min-h-full flex flex-col justify-center px-8 md:px-10 py-14">
  <div class="max-w-sm">


    <h2 class="text-4xl md:text-5xl font-bold text-white mb-3 leading-tight tracking-tight">
      Get In Touch
    </h2>

    <p class="text-base text-gray-400 font-light leading-relaxed mb-2 max-w-xs">
      Feel free to reach out for collaborations, mentorship, or just a chat about tech and startups!
    </p>

    <p class="text-sm text-gray-500 font-light leading-relaxed mb-10 max-w-xs">
      {site.availability.detail}
    </p>

    <div class="entry-list">
      {contacts.map((c) => (
        <a
          href={c.href}
          target={c.href.startsWith("mailto") ? undefined : "_blank"}
          rel={c.href.startsWith("mailto") ? undefined : "noopener noreferrer"}
          class="entry-row group relative flex items-center justify-between border-t border-white/[0.06] py-4 -mx-3 px-3 rounded"
        >
          <span
            aria-hidden="true"
            class="absolute left-0 inset-y-3 w-[2px] rounded-full bg-indigo-400/60 scale-y-0 group-hover:scale-y-100 opacity-0 group-hover:opacity-100 transition-all duration-500 origin-center"
          ></span>
          <div class="flex items-center gap-4">
            <span class="text-gray-500 group-hover:text-white transition-colors duration-500 flex-shrink-0">
              <span set:html={c.icon} />
            </span>
            <div>
              <p class="text-xs text-gray-500 font-semibold uppercase tracking-wider mb-0.5">{c.label}</p>
              <p class="text-base text-white font-semibold">{c.value}</p>
            </div>
          </div>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500 group-hover:text-gray-300 transition-colors flex-shrink-0">
            <path d="M7 17L17 7M7 7h10v10"/>
          </svg>
        </a>
      ))}
    </div>

  </div>
</div>
