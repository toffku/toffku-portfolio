---
import { projects, tagColors } from "@/data/projects";
---

<div class="min-h-full px-8 md:px-10 py-10 md:py-14">
  <div class="max-w-2xl">

    <div class="mb-10">
      <p class="font-mono text-xs text-white/[0.18] mb-3 tracking-wider">04 / Projects</p>
      <h2 class="text-2xl font-bold text-white tracking-tight">Featured Work</h2>
    </div>

    <div>
      {projects.map((project, i) => (
        <div class="group border-t border-white/[0.06] py-5 hover:bg-white/[0.04] -mx-3 px-3 rounded transition-colors duration-200">
          <div class="grid sm:grid-cols-[2.5rem_1fr] gap-x-6 gap-y-2">
            <span class="font-mono text-[10px] text-white/[0.20] sm:pt-0.5">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <div class="flex items-start justify-between gap-4 mb-1.5">
                <h3 class="text-sm font-semibold text-white">{project.name}</h3>
                {project.github ? (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs text-gray-700 hover:text-white font-semibold transition-colors flex items-center gap-1 flex-shrink-0"
                  >
                    Source
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17L17 7M7 7h10v10"/>
                    </svg>
                  </a>
                ) : (
                  <span class="text-xs text-gray-700 font-light flex-shrink-0">Private</span>
                )}
              </div>
              <p class="text-xs text-gray-600 font-light leading-relaxed mb-2.5">{project.description}</p>
              <div class="flex flex-wrap gap-x-3 gap-y-1">
                {project.tags.map((tag) => (
                  <span class={`text-xs font-mono ${tagColors[tag] ?? "text-gray-600"}`}>{tag}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="border-t border-white/[0.06] pt-5 mt-2 flex items-center justify-between">
      <p class="text-xs text-gray-700 font-light">More work on GitHub</p>
      <a
        href="https://github.com/toffku"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-gray-600 hover:text-white font-semibold flex items-center gap-1 transition-colors"
      >
        @toffku
        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7M7 7h10v10"/>
        </svg>
      </a>
    </div>

  </div>
</div>
