---
import { projects } from "@/data/projects";
---

<div class="min-h-full px-8 md:px-10 py-10 md:py-14">
  <div class="max-w-2xl">

    <div class="mb-10">
      <h2 class="text-3xl font-bold text-white tracking-tight">Featured Work</h2>
    </div>

    <div class="entry-list">
      {projects.map((project, i) => (
        <div class="entry-row group relative border-t border-white/[0.06] py-5 -mx-3 px-3 rounded">
          <span
            aria-hidden="true"
            class="absolute left-0 inset-y-3 w-[2px] rounded-full bg-indigo-400/60 scale-y-0 group-hover:scale-y-100 opacity-0 group-hover:opacity-100 transition-all duration-500 origin-center"
          ></span>
          <div class="grid sm:grid-cols-[2.5rem_1fr] gap-x-6 gap-y-2">
            <span class="font-mono text-xs text-white/[0.30] sm:pt-0.5">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <div class="flex items-start justify-between gap-4 mb-1.5">
                <h3 class="text-base font-semibold text-white">{project.name}</h3>
                {project.github ? (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-gray-500 hover:text-white font-semibold transition-colors flex items-center gap-1 flex-shrink-0"
                  >
                    Source
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17L17 7M7 7h10v10"/>
                    </svg>
                  </a>
                ) : (
                  <span class="text-sm text-gray-500 font-light flex-shrink-0">Private</span>
                )}
              </div>
              <p class="text-sm text-gray-400 font-normal leading-relaxed mb-2.5">{project.description}</p>
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5">
                {project.tags.map((tag, i) => (
                  <span class="contents">
                    {i > 0 && <span aria-hidden="true" class="w-px h-2.5 bg-white/[0.12] flex-shrink-0" />}
                    <span class="font-label text-xs text-white/45 tracking-wide">{tag}</span>
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="border-t border-white/[0.06] pt-5 mt-2 flex items-center justify-between">
      <p class="text-sm text-gray-500 font-light">More work on GitHub</p>
      <a
        href="https://github.com/toffku"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-gray-400 hover:text-white font-semibold flex items-center gap-1 transition-colors"
      >
        @toffku
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7M7 7h10v10"/>
        </svg>
      </a>
    </div>

  </div>
</div>
